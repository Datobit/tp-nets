# Skopiuj do .env i ustaw własne wartości. Nie commituj pliku .env.
POSTGRES_PASSWORD=zmien-tu-haslo-bazy

# Sekret sesji (min. 32 znaki). Wygeneruj JEDNORAZOWO, jeśli go brakuje:
#   grep -q '^APP_SESSION_SECRET=' .env || echo "APP_SESSION_SECRET=$(openssl rand -base64 48)" >> .env
APP_SESSION_SECRET=

# Opcjonalnie: publiczny adres HTTPS aplikacji (Tailscale Serve), np.
# APP_PUBLIC_URL=https://twoj-host.twoj-tailnet.ts.net
APP_PUBLIC_URL=
